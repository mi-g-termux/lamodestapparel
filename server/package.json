{
  "name": "@velora/server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "dev": "node --watch --experimental-strip-types src/index.ts",
    "migrate": "node scripts/build.mjs dist/scripts/migrate.js && node dist/scripts/migrate.js",
    "migrate:built": "node dist/scripts/migrate.js",
    "seed:admin": "node scripts/build.mjs dist/scripts/create-admin.js && node dist/scripts/create-admin.js",
    "seed:admin:built": "node dist/scripts/create-admin.js",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "express": "^4.21.2",
    "multer": "^1.4.5-lts.1",
    "nodemailer": "^6.9.16",
    "pdfkit": "^0.15.1",
    "pg": "^8.13.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.10.2",
    "@types/nodemailer": "^6.4.17",
    "@types/pdfkit": "^0.13.9",
    "@types/pg": "^8.11.10",
    "typescript": "^5.7.2"
  }
}
