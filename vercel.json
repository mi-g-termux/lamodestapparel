{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run install:all && npm run build",
  "outputDirectory": "web/dist",
  "installCommand": "npm install",
  "framework": null,
  "functions": {
    "api/index.js": {
      "maxDuration": 30,
      "memory": 1024
    }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/index.js" },
    { "source": "/((?!assets/|favicon|robots.txt|sitemap.xml).*)", "destination": "/index.html" }
  ],
  "crons": [
    { "path": "/api/cron/fx", "schedule": "0 * * * *" },
    { "path": "/api/cron/low-stock", "schedule": "*/15 * * * *" },
    { "path": "/api/cron/stuck-payments", "schedule": "*/10 * * * *" },
    { "path": "/api/cron/cleanup", "schedule": "30 3 * * *" }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    }
  ]
}
