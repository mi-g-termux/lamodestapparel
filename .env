# ---------------------------------------------------------------------------
# Infrastructure only.
#
# Nothing about your BUSINESS lives here. Store name, logo, currency, SMTP,
# order prefix, feature switches and everything else are edited in the admin
# panel and stored in the database. Copy this file to .env and fill it in once.
# ---------------------------------------------------------------------------

# Postgres connection string (Supabase, Neon, or your cPanel Postgres).
# Supabase: Project settings -> Database -> Connection string -> URI
DATABASE_URL=postgresql://postgres:[TESTE343sdsW6C]@db.oyowdjcbdzedxbggjqhb.supabase.co:5432/postgres
# postgresql://postgres.wgxiouvxgutumcmixbwt:drshop0976ko@aws-0-ap-southeast-2.pooler.supabase.com:5432/postgres?sslmode=require
# Your public site address, no trailing slash. Example: https prefix + yourshop.com
SITE_URL=http://localhost:3000

# 32+ random characters. Encrypts saved SMTP/payment secrets and signs sessions.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
APP_SECRET=Eqf1JUlM9R4MvB9hSJeD3BTAqKVPrJys


# node  -> normal server (cPanel, VPS, Docker, local)
# vercel -> serverless (read-only disk, uploads must use image URLs or object storage)
DEPLOY_TARGET=node

# Port for the Node process. cPanel sets this for you; ignore it on Vercel.
PORT=3000

# Where uploaded images are written (ignored when DEPLOY_TARGET=vercel).
UPLOAD_DIR=./uploads

# Random string used to protect the scheduled jobs at /api/cron/*.
CRON_SECRET=

# Extra browser origins allowed to call the API, comma separated.
# Leave blank unless the admin panel is on a different domain.
ALLOWED_ORIGINS=http://localhost:3000

# Set to 1 behind Cloudflare, Vercel, or an Apache/LiteSpeed reverse proxy so
# real visitor IPs are used for rate limiting.
TRUST_PROXY=1

NODE_ENV=production
